# Never commit real values. Use a unique long password and a 32+ character random session secret.
KEIBA_ACCESS_PASSWORD=replace-with-presentation-password
KEIBA_SESSION_SECRET=replace-with-at-least-32-random-characters
# Required in Vercel for shared login throttling across serverless instances. Do not use a local in-memory fallback.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# Development server only. Production builds always suppress the local presentation-demo guide.
KEIBA_LOCAL_PRESENTATION_DEMO=false
